# =====================================================================
#  PER-VM settings.   cp config/local.env.example config/local.env
#  then edit. This file is git-ignored (each VM keeps its own copy).
# =====================================================================

# Which node is THIS machine? 1 = ingestion, 2 = storage, 3 = compute, 4 = search
NODE_ID=1

# Install locations (match what you used for the Kafka/Spark assignment).
# Node 4 only needs Python, so the three paths below can stay as-is there.
JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64
HADOOP_HOME=/usr/local/hadoop
SPARK_HOME=/opt/spark

# Python used by the Spark driver AND executors.
# Must be the SAME minor version on Nodes 1, 2 and 3 (3.8 - 3.10 for Spark 3.3.x).
PYSPARK_PYTHON=python3

# Where this VM keeps HDFS blocks / NameNode metadata (Nodes 2 and 3).
# A fresh directory avoids clusterID clashes with older single-node labs.
HDFS_DATA_ROOT=$HOME/dse-hdfs

# Spark worker resources (Nodes 2 and 3) - keep below the VM's RAM/cores.
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=1g
SPARK_DRIVER_MEMORY=1g

# Iceberg runtime jar (installed by scripts/install_iceberg.sh)
ICEBERG_JAR=/opt/iceberg/iceberg-spark-runtime-3.3_2.12-1.8.1.jar

# Node 4 only: local directory where versioned exports are kept (/serving/vN/)
SERVING_DIR=/serving
