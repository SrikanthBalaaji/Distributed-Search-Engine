<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!-- GENERATED by scripts/render_configs.sh for node ${NODE_ID} (${THIS_NODE_HOST}) -->
<configuration>
  <!-- ===== Replication: 2 DataNodes (Node 2 + Node 3) => RF = 2 ===== -->
  <property>
    <name>dfs.replication</name>
    <value>${HDFS_REPLICATION}</value>
  </property>
  <property>
    <name>dfs.blocksize</name>
    <value>${HDFS_BLOCKSIZE}</value>
  </property>

  <!-- ===== Storage directories (only used on Node 2 / Node 3) ===== -->
  <property>
    <name>dfs.namenode.name.dir</name>
    <value>file://${HDFS_DATA_ROOT}/namenode</value>
  </property>
  <property>
    <name>dfs.datanode.data.dir</name>
    <value>file://${HDFS_DATA_ROOT}/datanode</value>
  </property>

  <!-- ===== NameNode addresses (Node 2) - bind on all interfaces incl. ZeroTier ===== -->
  <property>
    <name>dfs.namenode.rpc-address</name>
    <value>${NODE2_HOST}:${HDFS_NAMENODE_PORT}</value>
  </property>
  <property>
    <name>dfs.namenode.rpc-bind-host</name>
    <value>0.0.0.0</value>
  </property>
  <property>
    <name>dfs.namenode.servicerpc-bind-host</name>
    <value>0.0.0.0</value>
  </property>
  <property>
    <name>dfs.namenode.http-address</name>
    <value>${NODE2_HOST}:${HDFS_NAMENODE_HTTP_PORT}</value>
  </property>
  <property>
    <name>dfs.namenode.http-bind-host</name>
    <value>0.0.0.0</value>
  </property>

  <!-- ===== DataNodes advertise their ZeroTier alias, clients connect by alias ===== -->
  <property>
    <name>dfs.datanode.hostname</name>
    <value>${THIS_NODE_HOST}</value>
  </property>
  <property>
    <name>dfs.datanode.address</name>
    <value>0.0.0.0:9866</value>
  </property>
  <property>
    <name>dfs.datanode.http.address</name>
    <value>0.0.0.0:${HDFS_DATANODE_HTTP_PORT}</value>
  </property>
  <property>
    <name>dfs.datanode.ipc.address</name>
    <value>0.0.0.0:9867</value>
  </property>
  <property>
    <name>dfs.client.use.datanode.hostname</name>
    <value>true</value>
  </property>
  <property>
    <name>dfs.datanode.use.datanode.hostname</name>
    <value>true</value>
  </property>
  <!-- ZeroTier IPs usually have no reverse DNS -->
  <property>
    <name>dfs.namenode.datanode.registration.ip-hostname-check</name>
    <value>false</value>
  </property>

  <!-- ===== Misc ===== -->
  <!-- 4 different Linux users on 4 VMs -> disable HDFS permission checks for the project -->
  <property>
    <name>dfs.permissions.enabled</name>
    <value>false</value>
  </property>
  <!-- WebHDFS is how Node 4 pulls /serving/vN without running any Hadoop daemon -->
  <property>
    <name>dfs.webhdfs.enabled</name>
    <value>true</value>
  </property>
  <!-- detect a dead DataNode in ~1 min instead of ~10 min (fault-tolerance demo) -->
  <property>
    <name>dfs.namenode.heartbeat.recheck-interval</name>
    <value>15000</value>
  </property>
  <property>
    <name>dfs.heartbeat.interval</name>
    <value>3</value>
  </property>
  <!-- with only 2 DataNodes, don't fail writes when one is briefly down -->
  <property>
    <name>dfs.client.block.write.replace-datanode-on-failure.policy</name>
    <value>NEVER</value>
  </property>
</configuration>
