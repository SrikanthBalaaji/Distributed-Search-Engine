#!/usr/bin/env bash
# GENERATED by scripts/render_configs.sh for node ${NODE_ID} (${THIS_NODE_HOST})
# Read by start-master.sh / start-worker.sh / spark-submit (SPARK_CONF_DIR points here).

export JAVA_HOME="${JAVA_HOME}"
export HADOOP_CONF_DIR="${HADOOP_CONF_DIR}"
export HADOOP_USER_NAME="${HDFS_USER}"
export PYSPARK_PYTHON="${PYSPARK_PYTHON}"
export PYTHONHASHSEED=0

# Bind Spark to this VM's ZeroTier IP so other nodes can reach it
export SPARK_LOCAL_IP="${THIS_NODE_IP}"
export SPARK_PUBLIC_DNS="${THIS_NODE_IP}"

# Spark master runs on Node 3
export SPARK_MASTER_HOST="${NODE3_IP}"
export SPARK_MASTER_PORT="${SPARK_MASTER_PORT}"
export SPARK_MASTER_WEBUI_PORT="${SPARK_MASTER_WEBUI_PORT}"

# Worker resources (Nodes 2 and 3)
export SPARK_WORKER_CORES="${SPARK_WORKER_CORES}"
export SPARK_WORKER_MEMORY="${SPARK_WORKER_MEMORY}"
export SPARK_WORKER_DIR="${HDFS_DATA_ROOT}/spark-work"
export SPARK_LOG_DIR="${DSE_ROOT}/logs/spark"
export SPARK_PID_DIR="${HDFS_DATA_ROOT}/pids"
