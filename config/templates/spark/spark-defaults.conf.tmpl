# GENERATED by scripts/render_configs.sh for node ${NODE_ID} (${THIS_NODE_IP})
# Passed to spark-submit via --properties-file by scripts/submit.sh.

# ---------- cluster ----------
spark.master                         spark://${NODE3_IP}:${SPARK_MASTER_PORT}
spark.driver.host                    ${THIS_NODE_IP}
spark.driver.bindAddress             0.0.0.0
spark.driver.port                    ${SPARK_DRIVER_PORT}
spark.blockManager.port              ${SPARK_BLOCKMANAGER_PORT}
spark.port.maxRetries                32

# ---------- resources (small VMs) ----------
spark.driver.memory                  ${SPARK_DRIVER_MEMORY}
spark.executor.memory                ${SPARK_EXECUTOR_MEMORY}
spark.executor.cores                 1
spark.sql.shuffle.partitions         ${SPARK_SHUFFLE_PARTITIONS}
spark.default.parallelism            ${SPARK_SHUFFLE_PARTITIONS}
spark.serializer                     org.apache.spark.serializer.KryoSerializer

# ---------- fault tolerance ----------
spark.task.maxFailures               4
spark.stage.maxConsecutiveAttempts   4
spark.network.timeout                120s
spark.executor.heartbeatInterval     10s

# ---------- python ----------
spark.pyspark.python                 ${PYSPARK_PYTHON}
spark.executorEnv.PYTHONHASHSEED     0
spark.executorEnv.HADOOP_USER_NAME   ${HDFS_USER}

# ---------- HDFS client (RF=2, connect to DataNodes by ZeroTier alias) ----------
spark.hadoop.fs.defaultFS                       hdfs://${NODE2_HOST}:${HDFS_NAMENODE_PORT}
spark.hadoop.dfs.replication                    ${HDFS_REPLICATION}
spark.hadoop.dfs.client.use.datanode.hostname   true
spark.hadoop.dfs.client.block.write.replace-datanode-on-failure.policy NEVER

# ---------- event logs (Spark history server) ----------
spark.eventLog.enabled               true
spark.eventLog.dir                   hdfs://${NODE2_HOST}:${HDFS_NAMENODE_PORT}${HDFS_EVENTLOG_DIR}
spark.history.fs.logDirectory        hdfs://${NODE2_HOST}:${HDFS_NAMENODE_PORT}${HDFS_EVENTLOG_DIR}

# ---------- Apache Iceberg (as in the hands-on, but the warehouse is on the Node 2 NameNode) ----------
spark.jars                                       ${ICEBERG_JAR}
spark.sql.extensions                             org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions
spark.sql.catalog.${ICEBERG_CATALOG}             org.apache.iceberg.spark.SparkCatalog
spark.sql.catalog.${ICEBERG_CATALOG}.type        hadoop
spark.sql.catalog.${ICEBERG_CATALOG}.warehouse   hdfs://${NODE2_HOST}:${HDFS_NAMENODE_PORT}${HDFS_WAREHOUSE_DIR}
