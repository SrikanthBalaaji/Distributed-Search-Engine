# =====================================================================
#  TEAM-WIDE cluster settings  (same file on all 4 VMs -> commit it)
# =====================================================================
# The team lead fills in the ZeroTier IPs ONCE, commits, and everyone
# pulls. Find a VM's ZeroTier IP with:
#     ip -4 addr show | grep -A2 zt      (or)   sudo zerotier-cli listnetworks
#
# Per-VM things (NODE_ID, JAVA_HOME, SPARK_HOME, ...) go in config/local.env
# =====================================================================

# ---- ZeroTier IPs (EDIT THESE) --------------------------------------
NODE1_IP=172.27.211.189     # Nikhil    (x86_64) - Ingestion gateway (Spark driver for ingestion, client only)
NODE2_IP=172.27.180.147     # Sathya    (arm64)  - HDFS NameNode + DataNode + Spark Worker + Iceberg storage
NODE3_IP=172.27.143.38      # Srikanth  (x86_64) - Spark Master + Spark Worker + HDFS DataNode + pipeline drivers
NODE4_IP=172.27.88.66       # Sushanth  (arm64)  - FastAPI search service + UI

# ---- Hostname aliases written to /etc/hosts by scripts/setup_hosts.sh ----
# (aliases only - you do NOT need to rename your machines)
NODE1_HOST=dse-node1
NODE2_HOST=dse-node2
NODE3_HOST=dse-node3
NODE4_HOST=dse-node4

# ---- HDFS -----------------------------------------------------------
HDFS_NAMENODE_PORT=9000
HDFS_NAMENODE_HTTP_PORT=9870
HDFS_DATANODE_HTTP_PORT=9864
HDFS_REPLICATION=2
HDFS_BLOCKSIZE=4m            # small blocks so pages.jsonl spans >1 block (shows distribution)
HDFS_USER=hadoop             # single HDFS identity used from every VM (HADOOP_USER_NAME)

# ---- Spark ----------------------------------------------------------
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8080
SPARK_DRIVER_PORT=7078
SPARK_BLOCKMANAGER_PORT=7079
SPARK_SHUFFLE_PARTITIONS=8

# ---- Iceberg (versions from the Apache Iceberg hands-on) ------------
ICEBERG_VERSION=1.8.1
ICEBERG_CATALOG=iceberg_catalog
ICEBERG_NAMESPACE=dse

# ---- HDFS layout ----------------------------------------------------
HDFS_RAW_DIR=/dse/raw                 # uploaded pages.jsonl / changes.jsonl
HDFS_WAREHOUSE_DIR=/warehouse         # Iceberg warehouse (tables live in /warehouse/dse/...)
HDFS_SERVING_DIR=/serving             # Spark export output  /serving/vN/
HDFS_CHECKPOINT_DIR=/dse/checkpoints  # PageRank RDD checkpoints (fault tolerance)
HDFS_EVENTLOG_DIR=/spark-logs         # Spark event logs (history server)

# ---- Search service (Node 4) ----------------------------------------
SEARCH_PORT=8000
# Shared secret for POST /api/admin/* (Node 3 sends it when notifying Node 4).
# Leave empty to disable the check (fine inside a private ZeroTier network).
ADMIN_TOKEN=
